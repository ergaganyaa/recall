# Copy to .env.local and fill in from Supabase: Project Settings -> API Keys.
# Only the public URL and the publishable (formerly "anon") key are needed.
# Data access goes through the signed-in user's session and row level
# security, so no secret/service-role key is used or required.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY also works if your project still shows an "anon" key.

# --- AI assistant (Google Gemini, free tier) -------------------------------------------------
# Create a free key in Google AI Studio: https://aistudio.google.com/  (no billing needed).
# SERVER-SIDE ONLY: never prefix it with NEXT_PUBLIC_, never commit a real key.
GEMINI_API_KEY=your-gemini-api-key
# Optional. Default gemini-3.5-flash-lite (stable and free per Google's docs when this was written).
# Use gemini-3.8-flash for higher quality. Check which models your key may use in Google AI Studio.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional cost / size controls (defaults shown):
# ASSISTANT_MAX_OUTPUT_TOKENS=700      # cap on the length of each answer
# ASSISTANT_MAX_PASSAGES=8             # passages sent per question (max 12)
# ASSISTANT_PASSAGES_PER_CHAPTER=2
# ASSISTANT_CONTEXT_CHARS=6000         # total size of the passages sent
# ASSISTANT_HISTORY_CHARS=3000         # how much earlier conversation is sent
# ASSISTANT_HISTORY_MESSAGES=8
# ASSISTANT_TIMEOUT_MS=20000
# ASSISTANT_MAX_PER_MINUTE=6           # per-user question limits that protect the free quota
# ASSISTANT_MAX_PER_DAY=150
